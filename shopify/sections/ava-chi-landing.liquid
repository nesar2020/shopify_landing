{%- comment -%} Real product photos: pull from Settings > Files by name, fall back to SVG art {%- endcomment -%}
{%- assign _exts = 'jpg,jpeg,png,webp' | split: ',' -%}
{%- assign hero_url = '' -%}{%- assign benefit_sleep_url = '' -%}{%- assign benefit_back_url = '' -%}{%- assign benefit_legs_url = '' -%}
{%- for e in _exts -%}
  {%- if hero_url == blank -%}{%- assign _t = 'hero-main.' | append: e | file_url -%}{%- if _t != blank -%}{%- assign hero_url = _t -%}{%- endif -%}{%- endif -%}
  {%- if benefit_sleep_url == blank -%}{%- assign _t = 'benefit-sleep.' | append: e | file_url -%}{%- if _t != blank -%}{%- assign benefit_sleep_url = _t -%}{%- endif -%}{%- endif -%}
  {%- if benefit_back_url == blank -%}{%- assign _t = 'benefit-back.' | append: e | file_url -%}{%- if _t != blank -%}{%- assign benefit_back_url = _t -%}{%- endif -%}{%- endif -%}
  {%- if benefit_legs_url == blank -%}{%- assign _t = 'benefit-legs.' | append: e | file_url -%}{%- if _t != blank -%}{%- assign benefit_legs_url = _t -%}{%- endif -%}{%- endif -%}
{%- endfor -%}
<style>
/* AVA-consistent design system — single light look, explicit colors (brand fidelity) */
:root{
  --white:#ffffff;
  --cream:#F5F0E7;
  --cream-2:#EFE8DB;
  --ink:#22262F;
  --ink-soft:#5B6070;
  --ink-faint:#8A8F9C;
  --line:#E6E0D4;
  --line-2:#ECE7DC;
  --black:#191A1F;
  --red:#E0322B;
  --red-soft:#FBE9E7;
  --teal:#2FA79C;
  --teal-deep:#1F8579;
  --teal-soft:#E4F3F1;
  --navy:#22262F;
  --gold:#F5A623;
  --r:14px;
  --r-lg:22px;
  --shadow:0 18px 40px -20px rgba(34,38,47,.22);
  --shadow-sm:0 8px 20px -12px rgba(34,38,47,.2);
  --maxw:1180px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--white);color:var(--ink);
  font-family:"Instrument Sans",system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  font-size:16.5px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,h4{font-family:"Lora",Georgia,serif;font-weight:600;line-height:1.14;margin:0;text-wrap:balance}
p{margin:0}
a{color:inherit;text-decoration:none}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px}
.stars{color:var(--gold);letter-spacing:1px}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;font-family:inherit;
  font-weight:700;font-size:16px;padding:16px 28px;border-radius:10px;border:0;cursor:pointer;
  background:var(--black);color:#fff;transition:transform .14s,background .2s,box-shadow .2s}
.btn:hover{transform:translateY(-1px);background:#000;box-shadow:0 12px 24px -12px rgba(0,0,0,.5)}
.btn.block{width:100%}
.btn.lg{padding:19px 30px;font-size:17px}
.btn.teal{background:var(--teal);}
.btn.teal:hover{background:var(--teal-deep)}
:focus-visible{outline:3px solid var(--teal);outline-offset:2px;border-radius:6px}

/* announcement */
.announce{background:var(--navy);color:#EAECEF;font-size:13px;font-weight:500;text-align:center;
  padding:9px 14px;letter-spacing:.01em}
.announce b{color:#fff}
.announce .sep{color:#5b6070;margin:0 10px}

/* header */
header.site{position:sticky;top:0;z-index:80;background:var(--white);border-bottom:1px solid var(--line)}
.hd{display:flex;align-items:center;gap:20px;height:66px}
.logo{display:flex;align-items:center;gap:9px;font-family:"Lora",serif;font-weight:700;font-size:26px;
  letter-spacing:.22em;color:var(--ink)}
.logo .eye{width:26px;height:26px;flex:none}
.search{flex:1;max-width:440px;position:relative}
.search input{width:100%;height:42px;border:1px solid var(--line);border-radius:9px;background:var(--cream);
  padding:0 40px 0 15px;font-family:inherit;font-size:14.5px;color:var(--ink)}
.search input::placeholder{color:var(--ink-faint)}
.search svg{position:absolute;right:13px;top:12px;color:var(--ink-faint)}
.hd-right{display:flex;align-items:center;gap:22px;margin-left:auto;font-size:14px;font-weight:600}
.hd-right a{display:flex;align-items:center;gap:7px}
.hd-cart{background:var(--cream);padding:9px 15px;border-radius:9px}
.catnav{border-bottom:1px solid var(--line);background:var(--white)}
.catnav .wrap{display:flex;gap:26px;height:46px;align-items:center;font-size:13.5px;font-weight:600;
  color:var(--ink-soft);overflow-x:auto}
.catnav a{white-space:nowrap}
.catnav a:hover{color:var(--ink)}
.catnav a.red{color:var(--red)}
@media(max-width:900px){.search{display:none}.hd-right .hide{display:none}}

/* hero */
.hero{padding:36px 0 8px}
.hero-in{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:start}
.gallery{position:relative}
.gmain{background:var(--cream);border-radius:var(--r-lg);aspect-ratio:1/1;display:grid;place-items:center;
  position:relative;overflow:hidden;border:1px solid var(--line-2)}
.gmain svg{width:88%;height:88%}
.burst{position:absolute;top:16px;left:16px;z-index:3;background:var(--red);color:#fff;font-weight:800;
  font-size:12.5px;letter-spacing:.04em;padding:9px 14px;border-radius:8px;transform:rotate(-4deg);
  box-shadow:0 8px 18px -8px rgba(224,50,43,.7);line-height:1.1;text-align:center}
.thumbs{display:flex;gap:10px;margin-top:12px}
.thumb{width:70px;height:70px;border-radius:11px;background:var(--cream);border:1px solid var(--line-2);
  display:grid;place-items:center;cursor:pointer;transition:border-color .15s}
.thumb.act{border-color:var(--ink)}
.thumb svg{width:70%;height:70%;opacity:.8}

.pinfo .prate{display:flex;align-items:center;gap:9px;font-size:13.5px;color:var(--ink-soft);font-weight:600}
.pinfo h1{font-size:clamp(26px,3.4vw,36px);margin:12px 0 4px;line-height:1.16}
.psub{color:var(--ink-soft);font-size:15px;margin-bottom:18px}
.pbul{list-style:none;padding:0;margin:0 0 22px;display:flex;flex-direction:column;gap:11px}
.pbul li{display:flex;gap:11px;align-items:flex-start;font-size:15px}
.pbul .ck{flex:none;width:22px;height:22px;border-radius:50%;background:var(--teal-soft);color:var(--teal-deep);
  display:grid;place-items:center;margin-top:1px}
.price-row{display:flex;align-items:center;gap:14px;margin-bottom:6px}
.price-now{background:var(--red);color:#fff;font-weight:800;font-size:24px;padding:6px 14px;border-radius:9px;
  font-family:"Instrument Sans";letter-spacing:.01em}
.price-old{color:var(--ink-faint);text-decoration:line-through;font-size:18px;font-weight:600}
.price-save{color:var(--red);font-weight:700;font-size:14px}
.qty-packs{display:flex;gap:10px;margin:16px 0}
.qp{flex:1;border:1.5px solid var(--line);border-radius:11px;padding:12px 14px;cursor:pointer;position:relative;
  transition:border-color .15s,background .15s}
.qp.sel{border-color:var(--teal);background:var(--teal-soft)}
.qp b{display:block;font-size:15px}
.qp small{color:var(--ink-soft);font-size:12.5px}
.qp .tag{position:absolute;top:-9px;right:10px;background:var(--red);color:#fff;font-size:10px;font-weight:800;
  padding:2px 8px;border-radius:99px;letter-spacing:.03em}
.trustline{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:14px;font-size:12.5px;color:var(--ink-soft)}
.trustline span{display:flex;align-items:center;gap:6px}
.trustline svg{color:var(--teal-deep)}
.retbox{display:flex;gap:14px;align-items:flex-start;background:var(--teal-soft);border:1px solid #CDE9E5;
  border-radius:var(--r);padding:16px 18px;margin-top:18px}
.retbox .eye{width:34px;height:34px;flex:none}
.retbox b{font-size:14.5px;color:var(--teal-deep)}
.retbox p{font-size:13px;color:var(--ink-soft);margin-top:2px}
@media(max-width:860px){.hero-in{grid-template-columns:1fr;gap:26px}}

/* section scaffold */
.pad{padding:74px 0}
.cream{background:var(--cream)}
.shead{text-align:center;max-width:640px;margin:0 auto 44px}
.shead .ey{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--teal-deep)}
.shead h2{font-size:clamp(26px,3.6vw,38px);margin-top:12px}
.shead p{color:var(--ink-soft);margin-top:12px;font-size:16.5px}

/* FAQ */
.faq{max-width:960px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:14px}
.qa{background:var(--white);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.qa summary{list-style:none;cursor:pointer;font-weight:600;font-size:15.5px;padding:18px 44px 18px 18px;
  position:relative;font-family:"Instrument Sans"}
.qa summary::-webkit-details-marker{display:none}
.qa summary::after{content:"+";position:absolute;right:16px;top:15px;font-size:22px;color:var(--teal-deep);font-weight:400}
.qa[open] summary::after{content:"\2013"}
.qa .a{padding:0 18px 18px;color:var(--ink-soft);font-size:14.5px}
@media(max-width:760px){.faq{grid-template-columns:1fr}}

/* benefit blocks */
.bblock{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;padding:26px 0}
.bblock.rev .bimg{order:2}
.bimg{border-radius:var(--r-lg);overflow:hidden;aspect-ratio:5/4;border:1px solid var(--line-2);
  display:grid;place-items:center;position:relative}
.bimg svg{width:100%;height:100%}
.btext h2{font-size:clamp(24px,3vw,32px);margin-bottom:14px}
.btext p{color:var(--ink-soft);font-size:16px;margin-bottom:12px}
.btext .mini{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:var(--teal-deep);
  background:var(--teal-soft);padding:7px 13px;border-radius:99px;margin-top:6px}
@media(max-width:860px){.bblock,.bblock.rev{grid-template-columns:1fr;gap:22px}.bblock.rev .bimg{order:0}}

/* comparison */
.cmp{max-width:940px;margin:0 auto;overflow-x:auto}
.cmp table{width:100%;border-collapse:collapse;min-width:600px;background:var(--white);border-radius:var(--r);
  overflow:hidden;box-shadow:var(--shadow-sm)}
.cmp th,.cmp td{padding:15px 16px;text-align:center;border-bottom:1px solid var(--line-2)}
.cmp thead th{font-family:"Lora",serif;font-size:16px;font-weight:600;background:var(--cream-2);position:relative}
.cmp thead th.us{background:var(--ink);color:#fff}
.cmp thead .tag{display:inline-block;background:var(--red);color:#fff;font-family:"Instrument Sans";font-size:10px;
  font-weight:800;letter-spacing:.06em;padding:3px 9px;border-radius:99px;margin-top:6px}
.cmp thead .tag.grey{background:transparent;color:var(--ink-faint);border:1px solid var(--line)}
.cmp tbody td:first-child{text-align:left;font-weight:600;color:var(--ink-soft);font-size:14.5px}
.cmp td.us{background:#FBFBFC}
.cmp tbody tr:last-child td{border-bottom:0}
.ck-y{color:var(--red);font-weight:800;font-size:18px}
.ck-n{color:#CBCFD6;font-size:16px}
.cmp .foot{text-align:center;color:var(--ink-soft);font-size:14px;margin-top:20px;max-width:620px;margin-left:auto;margin-right:auto}

/* reviews */
.rev-hd{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap;margin-bottom:8px}
.rev-hd .big{font-family:"Lora",serif;font-size:30px}
.rev-grid{columns:3;column-gap:18px;margin-top:34px}
.rcard{break-inside:avoid;background:var(--white);border:1px solid var(--line);border-radius:var(--r);
  padding:18px;margin-bottom:18px;box-shadow:var(--shadow-sm)}
.rcard .ph{aspect-ratio:4/3;border-radius:10px;margin-bottom:12px;display:grid;place-items:center;overflow:hidden}
.rcard .ph svg{width:100%;height:100%}
.rcard .stars{font-size:13px}
.rcard p{font-size:14.5px;margin:8px 0 12px}
.rwho{display:flex;align-items:center;gap:10px}
.rav{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;
  font-size:13px;flex:none}
.rwho b{font-size:13.5px;display:block}
.rwho small{color:var(--teal-deep);font-size:11.5px;font-weight:600;display:flex;align-items:center;gap:4px}
@media(max-width:980px){.rev-grid{columns:2}}
@media(max-width:620px){.rev-grid{columns:1}}

/* cross-sell */
.xrow{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.xcard{background:var(--white);border:1px solid var(--line);border-radius:var(--r);padding:14px;text-align:center}
.xcard .xi{aspect-ratio:1/1;background:var(--cream);border-radius:10px;display:grid;place-items:center;margin-bottom:10px}
.xcard .xi svg{width:64%;height:64%;opacity:.85}
.xcard h4{font-family:"Instrument Sans";font-size:13.5px;font-weight:600;line-height:1.3;margin-bottom:6px}
.xcard .xr{font-size:11px;color:var(--gold);margin-bottom:4px}
.xcard .xp{font-weight:800;color:var(--red);font-size:15px;margin-bottom:10px}
.xcard .xp small{color:var(--ink-faint);text-decoration:line-through;font-weight:600;font-size:12px;margin-left:5px}
.xcard .xbtn{display:block;background:var(--black);color:#fff;font-size:13px;font-weight:700;padding:9px;border-radius:8px}
@media(max-width:860px){.xrow{grid-template-columns:repeat(2,1fr)}}

/* trust bar */
.tbar{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--white)}
.tbar-in{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;padding:26px 0}
.tb{display:flex;align-items:center;gap:12px;justify-content:center}
.tb svg{color:var(--teal-deep);flex:none}
.tb b{font-size:14px;display:block}
.tb small{color:var(--ink-faint);font-size:12px}
@media(max-width:760px){.tbar-in{grid-template-columns:repeat(2,1fr);gap:22px}}

/* footer */
footer{background:var(--navy);color:#AEB3BE;padding:52px 0 120px;font-size:14px}
.foot-top{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:32px}
.foot-top h4{color:#fff;font-family:"Instrument Sans";font-size:12px;letter-spacing:.12em;text-transform:uppercase;margin:0 0 14px}
.foot-top a{display:block;margin-bottom:9px;color:#AEB3BE}
.foot-top a:hover{color:#fff}
.foot-logo{font-family:"Lora",serif;font-size:26px;letter-spacing:.2em;color:#fff;display:flex;align-items:center;gap:9px;margin-bottom:12px}
.pay{display:flex;gap:7px;flex-wrap:wrap;margin-top:14px}
.pay span{background:#fff;color:#22262F;font-weight:800;font-size:10px;padding:5px 8px;border-radius:5px;letter-spacing:.02em}
.foot-legal{border-top:1px solid #333844;margin-top:36px;padding-top:20px;display:flex;justify-content:space-between;
  gap:12px;flex-wrap:wrap;font-size:12.5px;color:#7C8290}
@media(max-width:860px){.foot-top{grid-template-columns:1fr 1fr}}

/* sticky mobile ATC */
.satc{position:fixed;left:0;right:0;bottom:0;z-index:90;background:#fff;border-top:1px solid var(--line);
  box-shadow:0 -8px 24px -14px rgba(0,0,0,.25);padding:10px 16px;display:none;align-items:center;gap:12px;
  transform:translateY(110%);transition:transform .3s}
.satc.show{transform:none}
.satc .si{flex:1;min-width:0}
.satc .si b{font-size:14px;display:block}
.satc .si small{color:var(--ink-faint);font-size:12px}
.satc .sp{font-weight:800;color:var(--red);font-size:18px}
.satc .btn{padding:13px 18px;font-size:14px}
@media(max-width:860px){.satc{display:flex}}

/* reveal */
.reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}html{scroll-behavior:auto}}
.gmain-img{width:100%;height:100%;object-fit:contain;border-radius:var(--r-lg)}
.bimg-img{width:100%;height:100%;object-fit:cover;display:block}
</style>

<!-- ===== ANNOUNCEMENT ===== -->
<div class="announce"><b>Fri fragt over 599 kr</b><span class="sep">·</span>1–2 dages levering<span class="sep">·</span><b>Pengene tilbage i 100 dage</b> – også selvom maskinen er brugt</div>

<!-- ===== HEADER ===== -->
<header class="site">
  <div class="wrap hd">
    <a class="logo" href="#top">
      <svg class="eye" viewBox="0 0 40 40" fill="none"><ellipse cx="20" cy="20" rx="18" ry="11" stroke="#2FA79C" stroke-width="2.4"/><circle cx="20" cy="20" r="5.5" fill="#2FA79C"/></svg>
      AVA</a>
    <div class="search"><input placeholder="Søg efter produkter…" aria-label="Søg"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4-4"/></svg></div>
    <div class="hd-right">
      <a class="hide" href="#faq">Hjælp</a>
      <a class="hide" href="#anmeldelser">Anmeldelser</a>
      <a class="hd-cart" href="#buy"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M6 6 5 3H2"/></svg> Kurv</a>
    </div>
  </div>
  <nav class="catnav"><div class="wrap">
    <a href="#">Wellness</a><a href="#">Massage</a><a href="#">Kropspleje</a><a href="#">Hår &amp; hud</a>
    <a href="#">Fødder &amp; ben</a><a href="#">Søvn</a><a href="#" class="red">Tilbud</a><a href="#">Om os</a>
  </div></nav>
</header>

<!-- ===== HERO ===== -->
<section class="hero" id="top">
  <div class="wrap hero-in">
    <!-- gallery -->
    <div class="gallery reveal in">
      <div class="gmain">
        <div class="burst">FAST<br>LAV PRIS</div>
        <!-- chi machine SVG -->
        {% if hero_url != blank %}<img class="gmain-img" src="{{ hero_url }}" alt="Premium Chi Maskine" loading="eager" onerror="this.remove()">{% else %}<svg viewBox="0 0 460 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Premium Chi Maskine">
          <defs>
            <linearGradient id="metal" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#E3E6EC"/></linearGradient>
            <linearGradient id="skin" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F0D9C6"/><stop offset="1" stop-color="#E3C3A9"/></linearGradient>
          </defs>
          <ellipse cx="230" cy="330" rx="170" ry="24" fill="#000" opacity=".06"/>
          <!-- sway arcs -->
          <path d="M150 300 q80 34 160 0" fill="none" stroke="#2FA79C" stroke-width="3" stroke-dasharray="4 8" stroke-linecap="round" opacity=".7"/>
          <path d="M140 174 l-14 -12 m0 12 l14 -12" stroke="#2FA79C" stroke-width="3.5" stroke-linecap="round"/>
          <path d="M320 174 l14 -12 m0 12 l-14 -12" stroke="#2FA79C" stroke-width="3.5" stroke-linecap="round"/>
          <!-- legs / calves resting -->
          <path d="M196 60 q-8 70 4 118 q4 20 24 20 q20 0 22 -22 q6 -66 -6 -118 q-4 -20 -22 -20 q-18 0 -22 22Z" fill="url(#skin)" stroke="#D8B99E" stroke-width="2"/>
          <path d="M250 60 q-6 70 6 118 q4 20 24 20 q20 0 21 -22 q4 -66 -8 -118 q-4 -20 -22 -20 q-18 0 -21 22Z" fill="url(#skin)" stroke="#D8B99E" stroke-width="2"/>
          <!-- feet on cradle -->
          <ellipse cx="220" cy="196" rx="26" ry="16" fill="url(#skin)" stroke="#D8B99E" stroke-width="2"/>
          <ellipse cx="278" cy="196" rx="26" ry="16" fill="url(#skin)" stroke="#D8B99E" stroke-width="2"/>
          <!-- machine body -->
          <rect x="120" y="210" width="220" height="78" rx="22" fill="url(#metal)" stroke="#CDD2DA" stroke-width="2"/>
          <rect x="120" y="262" width="220" height="26" rx="13" fill="#D2D7DF"/>
          <!-- cradle cushions -->
          <ellipse cx="220" cy="210" rx="34" ry="13" fill="#2FA79C" opacity=".9"/>
          <ellipse cx="278" cy="210" rx="34" ry="13" fill="#2FA79C" opacity=".9"/>
          <!-- control panel -->
          <rect x="150" y="230" width="70" height="24" rx="7" fill="#fff" stroke="#CDD2DA"/>
          <circle cx="165" cy="242" r="5" fill="#2FA79C"/><rect x="178" y="239" width="30" height="5" rx="2.5" fill="#C4C9D2"/>
          <circle cx="300" cy="238" r="10" fill="#fff" stroke="#CDD2DA"/><path d="M300 233v5l3 3" stroke="#22262F" stroke-width="2" stroke-linecap="round"/>
        </svg>{% endif %}
      </div>
